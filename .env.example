# ==============================================================================
# Configuración del SGA - ISFT N° 188 (Entorno Local / Demo)
# Copie este archivo como `.env` para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# Clave secreta de Django: DEBE ser única, aleatoria y secreta en cualquier entorno de producción.
SECRET_KEY=clave-secreta-de-ejemplo-cambiar-en-produccion-123456789

# Modo depuración (False por defecto para seguridad; WhiteNoise sirve estáticos en modo producción)
DEBUG=False

# Hosts autorizados separados por coma (ej. localhost,127.0.0.1,testserver,tudominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Orígenes confiables para CSRF en producción (separados por coma)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Motor de Base de Datos:
# Si DB_ENGINE no se define o PostgreSQL no está disponible, el sistema usa SQLite (db.sqlite3) automáticamente.
DB_ENGINE=sqlite3
# Para usar PostgreSQL descomente y configure:
# DB_ENGINE=postgresql
# DB_NAME=sga_db
# DB_USER=sga_user
# DB_PASSWORD=tu_password_seguro_aqui
# DB_HOST=localhost
# DB_PORT=5432
# DATABASE_URL=postgresql://sga_user:tu_password_seguro_aqui@localhost:5432/sga_db

# Usuario Administrador inicial para pruebas locales
# AVISO DE SEGURIDAD: ADMIN_PASSWORD debe cambiarse obligatoriamente en cualquier despliegue real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Carga de datos de demostración automáticos en Docker (True/False)
SEED_DEMO_DATA=False
